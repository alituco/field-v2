# Server-side Supabase environment. Never expose service-role or DB credentials
# to Flutter or commit a populated copy.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
DEV_SEED_PASSWORD=
# Optional only when overriding the default password for local Docker users.
LOCAL_DEV_SEED_PASSWORD=

# Tap Payments. Keep the secret key server-side; the Edge Function returns
# only a signed checkout configuration containing the publishable key.
TAP_SECRET_KEY=
TAP_PUBLIC_KEY=
TAP_MERCHANT_ID=
TAP_APPLE_PAY_ENABLED=false
# Optional override. Hosted environments default to their public Supabase
# tap-payment-webhook function URL. Tap cannot deliver webhooks to localhost.
TAP_WEBHOOK_URL=

# Legacy local scripts may still read DB_PASS.
DB_PASS=
