# Server-side Supabase environment. Never expose service-role or DB credentials
# to Flutter or commit a populated copy.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
DEV_SEED_PASSWORD=
# Optional only when overriding the default password for local Docker users.
LOCAL_DEV_SEED_PASSWORD=

# Stripe. Secret, webhook and worker keys are server-only, never Flutter defines.
# Staging requires test-mode keys. The publishable key may be used by mobile.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RECONCILE_SECRET=
APPLE_MERCHANT_ID=merchant.com.alialtaraif.fieldrush

# Legacy local scripts may still read DB_PASS.
DB_PASS=
