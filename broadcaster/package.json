{
  "name": "field-broadcaster",
  "version": "0.2.0",
  "description": "Guided Mac camera setup for Fieldrush referees",
  "author": "Fieldrush",
  "main": "src/desktop/main.mjs",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "test": "node --test test/*.test.mjs",
    "package:mac:local": "electron-builder --mac dir --arm64 -c.mac.identity=null -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "package:mac": "node scripts/build-mac.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "obs-websocket-js": "^5.0.8"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "gg.fieldrush.broadcaster",
    "productName": "Fieldrush Broadcaster",
    "asar": true,
    "files": ["src/desktop/**/*", "src/agent-client.mjs", "src/desktop-state.mjs", "src/obs-controller.mjs", "src/obs-process.mjs", "src/desktop-url.mjs", "src/recording-upload.mjs", "package.json"],
    "extraResources": [{ "from": "../mobile/assets/fonts", "to": "fonts", "filter": ["Outfit.ttf", "Outfit-LICENSE.txt", "PlusJakartaSans.ttf", "PlusJakartaSans-LICENSE.txt"] }],
    "directories": { "output": "dist" },
    "mac": {
      "icon": "../mobile/ios/Runner/Assets.xcassets/AppIcon.appiconset/Icon-App-1024x1024@1x.png",
      "category": "public.app-category.video",
      "target": ["dmg", "zip"],
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Preview your selected match camera before broadcasting.",
        "NSMicrophoneUsageDescription": "Check field audio before broadcasting your match."
      }
    }
  }
}
