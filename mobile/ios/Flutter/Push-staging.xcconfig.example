// Release-staging opt-in only after its App ID has Push Notifications enabled
// and its provisioning profile has been regenerated with Apple Pay AND push.
// TestFlight/App Store provisioning uses production APNs, even for this staging
// app. A development device profile instead needs development APNs.
FIELDRUSH_IOS_ENTITLEMENTS_FILE = Runner/Runner-staging-push.entitlements
FIELDRUSH_IOS_INFOPLIST_FILE = Runner/Info-staging-push.plist
FIELDRUSH_APNS_ENVIRONMENT = production
