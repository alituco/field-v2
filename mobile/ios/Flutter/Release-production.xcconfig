#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release-production.xcconfig"
#include "Generated.xcconfig"

APP_DISPLAY_NAME = Fieldrush
PRODUCT_BUNDLE_IDENTIFIER = com.alialtaraif.field
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
// Runner-only overrides keep app signing/plist settings out of Pods targets.
// The protected production uploader opts into the push variants explicitly.
FIELDRUSH_IOS_INFOPLIST_FILE = Runner/Info.plist
FIELDRUSH_IOS_ENTITLEMENTS_FILE = Runner/Runner-production.entitlements
CODE_SIGN_ENTITLEMENTS = $(FIELDRUSH_IOS_ENTITLEMENTS_FILE)
DEVELOPMENT_TEAM = 69B646V2WM
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Distribution
CODE_SIGN_IDENTITY[sdk=iphoneos*] = Apple Distribution
PROVISIONING_PROFILE_SPECIFIER = Fieldrush Production App Store
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
