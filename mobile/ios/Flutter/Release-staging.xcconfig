#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release-staging.xcconfig"
#include "Generated.xcconfig"

APP_DISPLAY_NAME = Fieldrush Staging
PRODUCT_BUNDLE_IDENTIFIER = com.alialtaraif.field.staging
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
// The TestFlight uploader opts in using these Runner-only settings. Keeping
// custom names avoids applying app plist/entitlements overrides to Pods targets.
FIELDRUSH_IOS_INFOPLIST_FILE = Runner/Info.plist
FIELDRUSH_IOS_ENTITLEMENTS_FILE = Runner/Runner-staging.entitlements
CODE_SIGN_ENTITLEMENTS = $(FIELDRUSH_IOS_ENTITLEMENTS_FILE)
DEVELOPMENT_TEAM = 69B646V2WM
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Distribution
CODE_SIGN_IDENTITY[sdk=iphoneos*] = Apple Distribution
PROVISIONING_PROFILE_SPECIFIER = Field Staging App Store
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
