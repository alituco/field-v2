APP_ENV=local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
DEV=true
PROFILE_SWITCHER_ENABLED=true
# Opt in only for staging after its SMTP and six-digit email-change setup.
# Staging: add --dart-define=EMAIL_DELIVERY_ENABLED=true to flutter run/build.
# Production stays disabled pending a separate approved SMTP/app rollout.
EMAIL_DELIVERY_ENABLED=false
# Phone push remains off until matching Firebase/APNs, backend dispatch and a
# real device build are qualified for the selected environment. Public client
# IDs are not server secrets. Production has no staging-ID fallback.
PUSH_NOTIFICATIONS_ENABLED=false
# Optional staging overrides; all matching platform fields are required in a
# production push build. iOS uses com.alialtaraif.field and Android uses
# gg.fieldrush.app. Never place Firebase service-account JSON in this file.
PUSH_FIREBASE_API_KEY=
PUSH_FIREBASE_PROJECT_ID=
PUSH_FIREBASE_SENDER_ID=
PUSH_FIREBASE_IOS_APP_ID=
PUSH_FIREBASE_IOS_BUNDLE_ID=
PUSH_FIREBASE_ANDROID_APP_ID=
PUSH_FIREBASE_ANDROID_PACKAGE_ID=
